<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>afterclass-apphost</UserSecretsId>
    <!-- Orchestrator and dashboard come from NuGet packages, so `dotnet run` works without the Aspire CLI. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Afterclass.Api\Afterclass.Api.csproj" />
    <ProjectReference Include="..\Afterclass.MigrationService\Afterclass.MigrationService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

</Project>
